{
  "manifest_version": 3,
  "name": "ShadowLens // AI Threat Shield",
  "version": "1.3.0",
  "description": "Real-time evidential neural browser protection against phishing URLs, quishing QR barcodes, and zero-day threats with Dirichlet uncertainty bounds.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["banner.js", "qr_auto_scan.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShadowLens Security",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
