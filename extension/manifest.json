{
  "manifest_version": 3,
  "name": "PhishShield-EDL Shield",
  "version": "1.2.0",
  "description": "Evidential deep learning browser security with real-time epistemic uncertainty, tier-1 block interstitial, and field ECE telemetry.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["banner.js", "qr_auto_scan.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield-EDL",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
